diff --git a/runtime/platform/unwinding_records_win.cc b/runtime/platform/unwinding_records_win.cc
index da871a640..f4f3542fc 100644
--- a/runtime/platform/unwinding_records_win.cc
+++ b/runtime/platform/unwinding_records_win.cc
@@ -29,6 +29,46 @@ intptr_t UnwindingRecordsPlatform::SizeInBytes() {
 // as it is the only client of these methods (e.g., _not_ in gen_snapshot).
 #if defined(UNWINDING_RECORDS_WINDOWS_HOST)
 
+namespace {
+
+struct GrowableFunctionTableApi {
+  decltype(&::RtlAddGrowableFunctionTable) add;
+  decltype(&::RtlDeleteGrowableFunctionTable) del;
+};
+
+// This pair of functions is not available on Windows 7, in which case both
+// pointers stay nullptr and callers skip unwinding record registration.
+const GrowableFunctionTableApi& GetGrowableFunctionTableApi() {
+  static GrowableFunctionTableApi api = []() {
+    GrowableFunctionTableApi result = {nullptr, nullptr};
+    HMODULE ntdll_module = ::GetModuleHandleW(L"ntdll.dll");
+    if (ntdll_module != nullptr) {
+      result.add = reinterpret_cast<decltype(&::RtlAddGrowableFunctionTable)>(
+          ::GetProcAddress(ntdll_module, "RtlAddGrowableFunctionTable"));
+      result.del =
+          reinterpret_cast<decltype(&::RtlDeleteGrowableFunctionTable)>(
+              ::GetProcAddress(ntdll_module, "RtlDeleteGrowableFunctionTable"));
+    }
+    // Either both available, or both not available.
+    if ((result.add == nullptr) != (result.del == nullptr)) {
+      result.add = nullptr;
+      result.del = nullptr;
+    }
+    return result;
+  }();
+  return api;
+}
+
+}  // namespace
+
+void* UnwindingRecordsPlatform::GetAddGrowableFunctionTableFunc() {
+  return reinterpret_cast<void*>(GetGrowableFunctionTableApi().add);
+}
+
+void* UnwindingRecordsPlatform::GetDeleteGrowableFunctionTableFunc() {
+  return reinterpret_cast<void*>(GetGrowableFunctionTableApi().del);
+}
+
 void UnwindingRecordsPlatform::RegisterExecutableMemory(
     void* start,
     intptr_t size,
@@ -43,12 +83,16 @@ void UnwindingRecordsPlatform::RegisterExecutableMemory(
     intptr_t size,
     void* records_start,
     void** pp_dynamic_table) {
+  auto add_function = GetGrowableFunctionTableApi().add;
+  if (add_function == nullptr) {
+    return;  // Windows 7.
+  }
   CodeRangeUnwindingRecord* record =
       reinterpret_cast<CodeRangeUnwindingRecord*>(records_start);
   RELEASE_ASSERT(record->magic == kUnwindingRecordMagic);
   uword start_num = reinterpret_cast<intptr_t>(start);
   uword end_num = start_num + size;
-  DWORD status = RtlAddGrowableFunctionTable(
+  DWORD status = add_function(
       pp_dynamic_table,
       /*FunctionTable=*/
       reinterpret_cast<PRUNTIME_FUNCTION>(record->runtime_function),
@@ -62,7 +106,11 @@ void UnwindingRecordsPlatform::RegisterExecutableMemory(
 }
 
 void UnwindingRecordsPlatform::UnregisterDynamicTable(void* p_dynamic_table) {
-  RtlDeleteGrowableFunctionTable(p_dynamic_table);
+  auto delete_function = GetGrowableFunctionTableApi().del;
+  if (delete_function == nullptr) {
+    return;  // Windows 7.
+  }
+  delete_function(p_dynamic_table);
 }
 
 #endif  // defined(UNWINDING_RECORDS_WINDOWS_HOST)
